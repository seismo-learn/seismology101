},"key":"aPf3yi9w4m"}],"key":"toUEm7Y8sC"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/seismology101/build/surface-wave-propaga-14ab174d8e895a495f31f607e6068ecb.jpg","alt":"\"面波的介质运动方向以及波传播方向\"","width":"50%","align":"center","key":"pZU5BHfxcC","urlSource":"surface-wave-propagation.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"基阶 Love 波（上）和 Rayleigh 波（下）的介质运动方向（假设面波沿着页面从左向右传播）。\n引自《","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"hQo4kLn7m2"},{"type":"link","url":"https://www.cambridge.org/us/academic/subjects/earth-and-environmental-science/solid-earth-geophysics/introduction-seismology-3rd-edition?format=HB&isbn=9781316635742","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Introduction to Seismology","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"QYCDgBl62u"}],"urlSource":"https://www.cambridge.org/us/academic/subjects/earth-and-environmental-science/solid-earth-geophysics/introduction-seismology-3rd-edition?format=HB&isbn=9781316635742","key":"EFiJ3xlQqF"},{"type":"text","value":"》（第三版）图 8.5。","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"V50al7kgK2"}],"key":"dw8IYsxxj4"}],"key":"XGs8iSRDI0"}],"enumerator":"2","key":"agymLrQUlG"}],"key":"YnkexEMsST"}],"key":"rGOHq3hRQI"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"震源","url":"/seismology/seismic-source","group":"地震学基础"},"next":{"title":"地震震相","url":"/seismology/seismic-phase","group":"地震学基础"}}},"domain":"http://localhost:3000"}