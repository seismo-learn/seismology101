},"key":"afmccgbq2E"}],"key":"EBrPVQEMtV"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/seismology101/build/surface-wave-propaga-080ad3281276ac61476495c7931750d2.jpg","alt":"\"面波的介质运动方向以及波传播方向\"","width":"50%","align":"center","key":"TcKY4yISDy","urlSource":"surface-wave-propagation.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"基阶 Love 波（上）和 Rayleigh 波（下）的介质运动方向（假设面波沿着页面从左向右传播）。\n引自《","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"QWMUsEMwE9"},{"type":"link","url":"https://www.cambridge.org/us/academic/subjects/earth-and-environmental-science/solid-earth-geophysics/introduction-seismology-3rd-edition?format=HB&isbn=9781316635742","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Introduction to Seismology","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Ha2rd58Aep"}],"urlSource":"https://www.cambridge.org/us/academic/subjects/earth-and-environmental-science/solid-earth-geophysics/introduction-seismology-3rd-edition?format=HB&isbn=9781316635742","key":"LG0gpoNMfm"},{"type":"text","value":"》（第三版）图 8.5。","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"FxSCszKItc"}],"key":"kgL1npPoKZ"}],"key":"d0hwcZZcHz"}],"enumerator":"2","key":"seg3K6pwUS"}],"key":"WCyxca5EaX"}],"key":"pVFFCCpied"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"震源","url":"/seismology/seismic-source","group":"地震学基础"},"next":{"title":"地震震相","url":"/seismology/seismic-phase","group":"地震学基础"}}},"domain":"http://localhost:3000"}