},"key":"zlJo4NlwvM"}],"key":"lcIGiBovSl"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/seismology101/build/surface-wave-propaga-66a5f32f98426ebe51b356580b8d73d3.jpg","alt":"\"面波的介质运动方向以及波传播方向\"","width":"50%","align":"center","key":"sdzPEhSDc1","urlSource":"surface-wave-propagation.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"基阶 Love 波（上）和 Rayleigh 波（下）的介质运动方向（假设面波沿着页面从左向右传播）。\n引自《","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"H8nNLptblH"},{"type":"link","url":"https://www.cambridge.org/us/academic/subjects/earth-and-environmental-science/solid-earth-geophysics/introduction-seismology-3rd-edition?format=HB&isbn=9781316635742","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Introduction to Seismology","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"cYfNBlthEE"}],"urlSource":"https://www.cambridge.org/us/academic/subjects/earth-and-environmental-science/solid-earth-geophysics/introduction-seismology-3rd-edition?format=HB&isbn=9781316635742","key":"cImrZE1VML"},{"type":"text","value":"》（第三版）图 8.5。","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"kbG91Y5RyC"}],"key":"HooNvrSrZH"}],"key":"sVq3Nhffj2"}],"enumerator":"2","key":"ZzdAhIfLPM"}],"key":"bdJFgqpvrc"}],"key":"BWilR7jtYe"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"震源","url":"/seismology/seismic-source","group":"地震学基础"},"next":{"title":"地震震相","url":"/seismology/seismic-phase","group":"地震学基础"}}},"domain":"http://localhost:3000"}