{"version":3,"kind":"Notebook","sha256":"1db0ff85fdc4364bc5f467285cf1ffb3bc273f098fe9eddda6fdebccc8e0ad11","slug":"exercises.detrend","location":"/exercises/detrend.md","dependencies":[],"frontmatter":{"title":"去线性趋势","kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"jupytext":{"text_representation":{"extension":".md","format_name":"myst","format_version":"0.13","jupytext_version":"1.13.0"}},"content_includes_title":false,"license":{"content":{"id":"CC-BY-NC-4.0","url":"https://creativecommons.org/licenses/by-nc/4.0/","name":"Creative Commons Attribution Non Commercial 4.0 International","CC":true}},"github":"https://github.com/seismo-learn/seismology101","numbering":{"title":{"offset":2}},"source_url":"https://github.com/seismo-learn/seismology101/blob/main/source/exercises/detrend.md","edit_url":"https://github.com/seismo-learn/seismology101/edit/main/source/exercises/detrend.md","exports":[{"format":"md","filename":"detrend.md","url":"/seismology101/build/detrend-d916535d698f08e8314961ce012af168.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"page-meta","children":[{"type":"paragraph","children":[{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"✍️ 何星辰、田冬冬、姚家园","key":"cMrY6qqnkz"}],"key":"gJrRRjV8ez"},{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"📅 2025-10-21","key":"Wnqk163cbo"}],"key":"bwQYiXAaAw"},{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"⏱️ 10 分钟","key":"pNO8mSviZs"}],"key":"FMmkTjcRAI"}],"key":"Y0tY1pSInL"}],"key":"rqrT3u5hdR"},{"type":"thematicBreak","key":"pFNiaqUbWo"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"去线性趋势是指计算出一条最能拟合整个波形数据的直线（即趋势线），并从每个数据点中减去该直线对应的值，\n使波形围绕稳定的零基线振动。此操作用于去除由温度变化或地壳形变等因素造成的缓慢漂移与基线偏移。","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"e7WiH5rKFp"}],"key":"mMEiDxdABe"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"我们以前一节使用的 2022 年 9 月 22 日墨西哥 Mw 6.8 地震在 ANMO 台站的波形为例。","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"xERjYiYwJJ"}],"key":"irA3N80bDe"}],"key":"lGpx6aHwBl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from obspy import UTCDateTime\nfrom obspy.clients.fdsn import Client\nimport matplotlib.pyplot as plt\nfrom numpy.polynomial import polynomial as P\n\nclient = Client(\"IRIS\") \n\n# 下载 2022 年墨西哥 Mw 6.8 级地震在 ANMO 台站的波形数据\nstarttime = UTCDateTime(\"2022-09-22T06:18:00\")\nendtime = starttime + 720  # 下载 12 分钟数据\nst = client.get_waveforms(\n    network=\"IU\",\n    station=\"ANMO\", \n    location=\"00\", \n    channel=\"BHZ\",\n    starttime=starttime, \n    endtime=endtime,\n)\nst.plot();","key":"IU3rKG4Z4m"},{"type":"outputs","id":"tPHluwMj0NM31mBDPhzWX","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/seismo-learn/lib/python3.14/site-packages/obspy/clients/fdsn/client.py:251: ObsPyDeprecationWarning: IRIS is now EarthScope, please consider changing the FDSN client short URL to 'EARTHSCOPE'.\n  warnings.warn(msg, ObsPyDeprecationWarning)\n"},"key":"uy1QVBV2Kz"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x250 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"430eb99d74f6197a59a71a47235f4906","path":"/seismology101/build/430eb99d74f6197a59a71a47235f4906.png"}}},"key":"GmMBONvQWr"}],"key":"mgeaCYqtDg"}],"key":"pcw39SXBzY"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"进行去线性趋势处理之前，通常需要先进行去均值操作。","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"tQ4Quz4iY2"}],"key":"j12K89qDZY"}],"key":"YX3bJR5HQx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tr = st[0]\n\n# 去均值\ntr.detrend(\"demean\")\n\n# 计算去线性趋势处理前的斜率\nslope_before = P.polyfit(tr.times(), tr.data, deg=1)[1]\nprint(f\"Slope before linear detrend: {slope_before}\")","key":"zG3zjeYR7H"},{"type":"outputs","id":"7-V0D_kRvdLkevMU39lAp","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Slope before linear detrend: -1.153520875022328\n"},"key":"ok1lNO3rNB"}],"key":"shSKiKw7Cs"}],"key":"ROckPSJcEY"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"ObsPy 提供了 ","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"vxJxgkFnZn"},{"type":"inlineCode","value":"obspy.core.trace.Trace.detrend","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"xWvx8jtsK9"},{"type":"text","value":" 方法可以实现去线性趋势操作。","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"faSw3cuqen"}],"key":"etrRYMzwFg"}],"key":"haFk6OY2Ky"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 去线性趋势\ntr.detrend(\"linear\")\n\n# 计算去线性趋势处理后的斜率\nslope_after = P.polyfit(tr.times(), tr.data, deg=1)[1]\nprint(f\"Slope after linear detrend: {slope_after}\")","key":"fINGVIUKD8"},{"type":"outputs","id":"y06NMYKH5vyG8AEepjpUJ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Slope after linear detrend: 1.7339993552341744e-14\n"},"key":"CJUjiX8IwQ"}],"key":"gTgmokMqh3"}],"key":"eNYYG2sTSl"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"可以看到，针对去均值后的波形，其斜率从 -1.15 降至 1.96e-14，说明 detrend 方法已成功校正基线。","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"e6uWuUaoTX"}],"key":"IlAo6FA2iB"}],"key":"XYC4kiLlYN"}],"key":"aeRwNBGZR0"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"去均值","url":"/exercises/demean","group":"地震学实践"},"next":{"title":"波形尖灭","url":"/exercises/taper","group":"地震学实践"}}},"domain":"http://localhost:3000"}