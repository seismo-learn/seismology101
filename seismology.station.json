{"version":3,"kind":"Article","sha256":"6499e34fce1aba0954e9e44934469ba202b4923cd97de7a21cf43345d801c3cd","slug":"seismology.station","location":"/seismology/station.md","dependencies":[],"frontmatter":{"title":"地震台站","content_includes_title":false,"license":{"content":{"id":"CC-BY-NC-4.0","url":"https://creativecommons.org/licenses/by-nc/4.0/","name":"Creative Commons Attribution Non Commercial 4.0 International","CC":true}},"github":"https://github.com/seismo-learn/seismology101","numbering":{"title":{"offset":1}},"source_url":"https://github.com/seismo-learn/seismology101/blob/main/source/seismology/station.md","edit_url":"https://github.com/seismo-learn/seismology101/edit/main/source/seismology/station.md","thumbnail":"/seismology101/_public/data-transimission-4960a746572f4f5c68c8de66bf422814.jpg","exports":[{"format":"md","filename":"station.md","url":"/seismology101/_public/station-d383dc10d62f2bd5d528bd98b11cb09c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"page-meta","children":[{"type":"paragraph","children":[{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"✍️ 姚家园、田冬冬","key":"tklvHiDG0N"}],"key":"boEfuka8ms"},{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"📅 2021-05-31","key":"Su3oAv28T9"}],"key":"RXanZUNMoQ"}],"key":"YycNfKiOJ3"}],"key":"IO9Qv74EyD"},{"type":"thematicBreak","key":"cSEFY0lHKZ"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"数据记录和传输","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"NgrxJo6dax"}],"identifier":"id","label":"数据记录和传输","html_id":"id","implicit":true,"key":"Wraht4HbWj"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"地震学工作者在全球范围布设了许多地震仪，有的布设在地表，有的布设在地下。\n有的地震仪配备了充电设备（如太阳能面板）、网络通讯设备，以便长期稳定地运行，并实时传输数据。","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"J5ouBzKvbH"}],"key":"jCcmVIq3JM"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"地震发生后，其激发的地震波会在地球内部传播。地震波传播至地震仪位置时，地震仪会随即将其记录下来，\n并将其转换为数字记录，存储起来。配有蜂窝电话、宽带网络或卫星通信系统的台站，还可以将数据实时\n传输到数据处理中心。最后，科研人员和大众可以利用互联网在数据中心下载数据，开展研究工作。","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"T6SfbiJwsP"}],"key":"dRdnvnEOUc"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/seismology101/_public/data-transimission-4960a746572f4f5c68c8de66bf422814.jpg","alt":"地震数据记录和传输示意图","width":"95%","align":"center","key":"Dj6za06dXB","urlSource":"data-transimission.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"地震学数据地记录和传输示意图。引自\n","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"GTsKFhrys8"},{"type":"link","url":"http://www.usarray.org/public/about/how#anchor1","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"How does a seismic station work?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"TCSlw5OErT"}],"urlSource":"http://www.usarray.org/public/about/how#anchor1","key":"H1y5VJWmCm"}],"key":"sawQXmR6yc"}],"key":"lSX2d18awa"}],"enumerator":"1","key":"VxBgeIpYJq"},{"type":"heading","depth":2,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"仪器响应","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"LJWSmmOFVW"}],"identifier":"id","label":"仪器响应","html_id":"id-1","implicit":true,"key":"Fjd84874EM"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"台站命名","position":{"start":{"line":29,"column":1},"end":{"line":29,"col