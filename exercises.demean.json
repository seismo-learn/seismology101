art":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"我们以 2022 年 9 月 22 日发生在墨西哥的一个 Mw 6.8 级地震为例，该地震的详细信息见 ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"Wg0vm7IjjI"},{"type":"link","url":"https://earthquake.usgs.gov/earthquakes/eventpage/us7000ia36","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"https://​earthquake​.usgs​.gov​/earthquakes​/eventpage​/us7000ia36","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"ZJGbozQpZx"}],"urlSource":"https://earthquake.usgs.gov/earthquakes/eventpage/us7000ia36","key":"Si07xyPxSb"},{"type":"text","value":"。","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"Fw5BwqS7Ya"}],"key":"lqao0mZbZl"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"使用 ObsPy 提供的 ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"kD58S4mxnX"},{"type":"inlineCode","value":"Client.get_waveforms() <obspy.clients.fdsn.client.Client.get_waveforms>","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"Vfi5Hg7vlY"},{"type":"text","value":" 方法下载\n该地震在 ANMO 台站的事件波形资料。","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"cQf9FjOeTv"}],"key":"NdZWg5lzut"}],"key":"rWlELMahYf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from obspy import UTCDateTime\nfrom obspy.clients.fdsn import Client\nimport matplotlib.pyplot as plt\n\nclient = Client(\"IRIS\") \n\n# 下载 2022 年墨西哥 Mw 6.8 级地震在 ANMO 台站的波形数据\nstarttime = UTCDateTime(\"2022-09-22T06:18:00\")\nendtime = starttime + 720  # 下载 12 分钟数据\nst = client.get_waveforms(\n    network=\"IU\",\n    station=\"ANMO\", \n    location=\"00\", \n    channel=\"BHZ\",\n    starttime=starttime, \n    endtime=endtime,\n)\nst.plot();","key":"gwlr5FPPNI"},{"type":"outputs","id":"xGT-IMZaEPx5GztbSgxhj","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/seismo-learn/lib/python3.14/site-packages/obspy/clients/fdsn/client.py:257: ObsPyDeprecationWarning: IRIS is now EarthScope, please consider changing the FDSN client short URL to 'EARTHSCOPE'.\n  warnings.warn(msg, ObsPyDeprecationWarning)\n"},"key":"nB9KLFjPT9"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x250 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"c4fbc088fe712dcd31a74f129bc3a937","path":"/seismology101/_public/c4fbc088fe712dcd31a74f129bc3a937.png"}}},"key":"K7wHdEXxpw"}],"key":"O1trafcz5N"}],"key":"y5mjt8WBBk"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"ObsPy 提供了 ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"jZaE43gVl9"},{"type":"inlineCode","value":"obspy.core.trace.Trace.detrend","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"fsL0ccTDKq"},{"type":"text","value":" 方法可以实现去均值操作。","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Nkd0Wqwaor"}],"key":"eR8rTwTRL4"}],"key":"qMGy8xCOL8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tr = st[0]\nprint(f\"Mean value before demean: {tr.data.mean()}\")\n\n# 去均值处理\ntr.detrend(\"demean\")  \n\nprint(f\"Mean value after demean: {tr.data.mean()}\")","key":"ZYh6FT88ka"},{"type":"outputs","id":"jLi5ng-v01xLIdNkKMaEO","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Mean value before demean: 1060.4151041666667\nMean value after demean: 4.042198674546348e-12\n"},"key":"LgLWMHXSac"}],"key":"PZSTvYIGMr"}],"key":"ovsBOSzQBc"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"虽然原始波形在视觉上观察不到显著的直流分量，但是去均值（demean）操作成功地\n将原始波形的均值从 1060.42 变为 4.04e-12，表明已经完成了去均值操作。","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"JlwNpnUWk7"}],"key":"deaHSL4HBe"}],"key":"hhaC9CyFVl"}],"key":"e2p8Ke7jD1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"数据处理","url":"/exercises/process","group":"地震学实践"},"next":{"title":"去线性趋势","url":"/exercises/detrend","group":"地震学实践"}}},"domain":"http://pre.render"}