{"version":3,"kind":"Notebook","sha256":"a5cd4d20bf391e36dd0520c6cca38149991068dc8f66be942cf93ca3d0941147","slug":"exercises.demean","location":"/exercises/demean.md","dependencies":[],"frontmatter":{"title":"去均值","kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"jupytext":{"text_representation":{"extension":".md","format_name":"myst","format_version":"0.13","jupytext_version":"1.13.0"}},"content_includes_title":false,"license":{"content":{"id":"CC-BY-NC-4.0","url":"https://creativecommons.org/licenses/by-nc/4.0/","name":"Creative Commons Attribution Non Commercial 4.0 International","CC":true}},"github":"https://github.com/seismo-learn/seismology101","numbering":{"title":{"offset":2}},"source_url":"https://github.com/seismo-learn/seismology101/blob/main/source/exercises/demean.md","edit_url":"https://github.com/seismo-learn/seismology101/edit/main/source/exercises/demean.md","exports":[{"format":"md","filename":"demean.md","url":"/seismology101/build/demean-157eaebb83b463dac0237b4784a1381c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"page-meta","children":[{"type":"paragraph","children":[{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"✍️ 何星辰、田冬冬、姚家园","key":"FYzZjE7J2v"}],"key":"kM9YlYxhrG"},{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"📅 2025-10-11","key":"MgFOgBVQ4y"}],"key":"u13tYqj5W8"},{"type":"span","class":"page-meta-item","children":[{"type":"text","value":"⏱️ 10 分钟","key":"xaDSku8C1U"}],"key":"FMJKFJRnWi"}],"key":"e0Ql7tttWC"}],"key":"Y5LWPmf4Je"},{"type":"thematicBreak","key":"pjzIUqW2gN"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"去均值是从每个数据点中减去所有数据点的平均值（也称直流分量），这一操作旨在消除仪器零点漂移，一般是数据处理的第一步。","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"JK4mMpLgt6"}],"key":"PngoGGGPH6"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"我们以 2022 年 9 月 22 日发生在墨西哥的一个 Mw 6.8 级地震为例，该地震的详细信息见 ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"XrxlGh8bv3"},{"type":"link","url":"https://earthquake.usgs.gov/earthquakes/eventpage/us7000ia36","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"https://​earthquake​.usgs​.gov​/earthquakes​/eventpage​/us7000ia36","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"K6PzcVPoOx"}],"urlSource":"https://earthquake.usgs.gov/earthquakes/eventpage/us7000ia36","key":"PSYNiODlkZ"},{"type":"text","value":"。","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"eItZAhSnhD"}],"key":"Mm89mnVH7M"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"使用 ObsPy 提供的 ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"aHazZZyRIs"},{"type":"inlineCode","value":"Client.get_waveforms() <obspy.clients.fdsn.client.Client.get_waveforms>","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ZdDaV0bErz"},{"type":"text","value":" 方法下载\n该地震在 ANMO 台站的事件波形资料。","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"zi6cSiv2F3"}],"key":"VweSBdqh0a"}],"key":"Pr8lzrgcU5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from obspy import UTCDateTime\nfrom obspy.clients.fdsn import Client\nimport matplotlib.pyplot as plt\n\nclient = Client(\"IRIS\") \n\n# 下载 2022 年墨西哥 Mw 6.8 级地震在 ANMO 台站的波形数据\nstarttime = UTCDateTime(\"2022-09-22T06:18:00\")\nendtime = starttime + 720  # 下载 12 分钟数据\nst = client.get_waveforms(\n    network=\"IU\",\n    station=\"ANMO\", \n    location=\"00\", \n    channel=\"BHZ\",\n    starttime=starttime, \n    endtime=endtime,\n)\nst.plot();","key":"rrnVN2tM9i"},{"type":"outputs","id":"iK4o2Z10WMTRFUdZnUcql","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/seismo-learn/lib/python3.14/site-packages/obspy/clients/fdsn/client.py:257: ObsPyDeprecationWarning: IRIS is now EarthScope, please consider changing the FDSN client short URL to 'EARTHSCOPE'.\n  warnings.warn(msg, ObsPyDeprecationWarning)\n"},"key":"zheD6UEsHe"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x250 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"c4fbc088fe712dcd31a74f129bc3a937","path":"/seismology101/build/c4fbc088fe712dcd31a74f129bc3a937.png"}}},"key":"UNJLRf9VFO"}],"key":"Ze7BTWGNNb"}],"key":"a5TOtS4VWR"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"ObsPy 提供了 ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"KkE0G0TNd7"},{"type":"inlineCode","value":"obspy.core.trace.Trace.detrend","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"cBm31x3MCB"},{"type":"text","value":" 方法可以实现去均值操作。","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"HPT6NFeOgu"}],"key":"TgGBWRxSVO"}],"key":"yllb49UrCx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tr = st[0]\nprint(f\"Mean value before demean: {tr.data.mean()}\")\n\n# 去均值处理\ntr.detrend(\"demean\")  \n\nprint(f\"Mean value after demean: {tr.data.mean()}\")","key":"Qam3iPSFGT"},{"type":"outputs","id":"C_kanjakvMY4WnwGcSO__","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Mean value before demean: 1060.4151041666667\nMean value after demean: 4.042198674546348e-12\n"},"key":"gG7Jr3lhy7"}],"key":"Kn5tbYgf5j"}],"key":"RcyR9RjqmG"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"虽然原始波形在视觉上观察不到显著的直流分量，但是去均值（demean）操作成功地\n将原始波形的均值从 1060.42 变为 4.04e-12，表明已经完成了去均值操作。","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"TsYZzbL6uI"}],"key":"XG23tHZHdL"}],"key":"Lt0gjZLfp8"}],"key":"GbcQl4TwDX"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"数据处理","url":"/exercises/process","group":"地震学实践"},"next":{"title":"去线性趋势","url":"/exercises/detrend","group":"地震学实践"}}},"domain":"http://localhost:3000"}