n class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">∗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">x</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.05724em;\">j</span><span class=\"mclose\">)</span><span class=\"mpunct\">,</span></span></span></span></span>","enumerator":"1","key":"eps9R7BCqu"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"其中 ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"MKTxwAIUwq"},{"type":"inlineMath","value":"w(j)","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>w</mi><mo stretchy=\"false\">(</mo><mi>j</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">w(j)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.02691em;\">w</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.05724em;\">j</span><span class=\"mclose\">)</span></span></span></span>","key":"nObocZT1IP"},{"type":"text","value":" 在信号首尾逐渐从 0 过渡到 1，并在中间区域保持为 1，实现波形的尖灭。","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ONZk16YtSm"}],"key":"NMDX5JqwVQ"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"下图比较了两种常用的尖灭窗：余弦窗 (cosine) 与 Hanning 窗 (hann)。本示例中，两端各 5% 长度用于平滑渐入/渐出，中间部分保持幅度 1。","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"gL6Ia52hWI"}],"key":"o2Lmlnsi1q"}],"key":"ttCFqqa8CG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom obspy.signal.invsim import cosine_taper  # ObsPy 余弦尖灭\n\n# 参数设置\nnpts = 1000\np = 0.05  # 两端 5%\n\n# 余弦尖灭窗\nwin_cos = cosine_taper(npts, p=p)\n\n# Hanning 窗（构造两端平滑、中间平坦）\nwin_han = np.ones(npts)\nedge = int(p * npts)\nhan_full = np.hanning(2 * edge)\nwin_han[:edge] = han_full[:edge]\nwin_han[-edge:] = han_full[-edge:]\n\nx = np.linspace(0, 1, npts)\nplt.figure(figsize=(9, 4))\nplt.plot(x, win_cos, 'r-', lw=2, label=f'Cosine (p={p})')\nplt.plot(x, win_han, 'b--', lw=2, label=f'Hanning (p={p})')\nplt.xlabel('Normalized Time')\nplt.ylabel('Amplitude')\nplt.title('Cosine vs Hanning Taper Windows')\nplt.legend()\nplt.show()","visibility":"hide","key":"yKn8ULqRu1"},{"type":"outputs","id":"InjSzNdYpwJy6QZWzNx-I","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 900x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"21d8fdaba4b19f7a8b1e4d62c1135885","path":"/seismology101/build/21d8fdaba4b19f7a8b1e4d62c1135885.png"}}},"key":"ZNYGl8KVyG"}],"visibility":"show","key":"QaZvOFYRKy"}],"data":{"tags":[]},"visibility":"show","key":"TwrejcCG9X"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"我们以前一节使用的 2022 年 9 月 22 日墨西哥 Mw 6.8 地震在 ANMO 台站的波形为例。","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"GW1utN4rBP"}],"key":"Tv7qqJLjeX"}],"key":"tVear1vtqN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from obspy import UTCDateTime\nfrom obspy.clients.fdsn import Client\nimport matplotlib.pyplot as plt\n\nclient = Client(\"IRIS\") \n\n# 下载 2022 年墨西哥 Mw 6.8 级地震在 ANMO 台站的波形数据(选择 400–700 s 时间窗)\norigin_time = UTCDateTime(\"2022-09-22T06:18:00\")\nstarttime = origin_time + 400\nendtime = origin_time + 700\nst = client.get_waveforms(\n    network=\"IU\",\n    station=\"ANMO\", \n    location=\"00\", \n    channel=\"BHZ\",\n    starttime=starttime, \n    endtime=endtime,\n)\nst.plot();","key":"OAMRfNYIgt"},{"type":"outputs","id":"FoOeCvEUN_oSfn9L7p1te","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/seismo-learn/lib/python3.14/site-packages/obspy/clients/fdsn/client.py:251: ObsPyDeprecationWarning: IRIS is now EarthScope, please consider changing the FDSN client short URL to 'EARTHSCOPE'.\n  warnings.warn(msg, ObsPyDeprecationWarning)\n"},"key":"uvOjdDCvbc"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x250 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"d33c4dcce9a0ce343c02bee3c23deffb","path":"/seismology101/build/d33c4dcce9a0ce343c02bee3c23deffb.png"}}},"key":"AHvo7H72nx"}],"key":"ZebTsvQMiy"}],"key":"kpqsgCykVW"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"进行尖灭处理之前，通常先进行去均值、去线性趋势。","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"axKSd8kDC6"}],"key":"TWm7ly5kay"}],"key":"GxYKJY3zbf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tr = st[0]\n\n# 去均值 + 去趋势\ntr.detrend(\"demean\")\ntr.detrend(\"linear\")\n\ntr_origin = tr.copy()   # 备份原始波形","key":"Ev0rNgyT8T"},{"type":"outputs","id":"hDcidW2VDCtkRungJk9bu","children":[],"key":"eVv2DTmgzD"}],"key":"pT2TiWQoNc"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":101,"column":1},"en