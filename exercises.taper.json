ne":32,"column":1}},"key":"ofp3SHdk96"}],"key":"IX7ENKVfV0"}],"key":"cTswCHU5sY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom obspy.signal.invsim import cosine_taper  # ObsPy 余弦尖灭\n\n# 参数设置\nnpts = 1000\np = 0.05  # 两端 5%\n\n# 余弦尖灭窗\nwin_cos = cosine_taper(npts, p=p)\n\n# Hanning 窗（构造两端平滑、中间平坦）\nwin_han = np.ones(npts)\nedge = int(p * npts)\nhan_full = np.hanning(2 * edge)\nwin_han[:edge] = han_full[:edge]\nwin_han[-edge:] = han_full[-edge:]\n\nx = np.linspace(0, 1, npts)\nplt.figure(figsize=(9, 4))\nplt.plot(x, win_cos, 'r-', lw=2, label=f'Cosine (p={p})')\nplt.plot(x, win_han, 'b--', lw=2, label=f'Hanning (p={p})')\nplt.xlabel('Normalized Time')\nplt.ylabel('Amplitude')\nplt.title('Cosine vs Hanning Taper Windows')\nplt.legend()\nplt.show()","visibility":"hide","key":"UATCSEXJ3Q"},{"type":"outputs","id":"1TnojSXLV4cKPnNq8puC0","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 900x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"abe7a2a3ea0f1159bcab7fb1585eeda7","path":"/seismology101/_public/abe7a2a3ea0f1159bcab7fb1585eeda7.png"}}},"key":"U7c5YJn4Mi"}],"visibility":"show","key":"YVEhsIUJ1i"}],"data":{"tags":[]},"visibility":"show","key":"Xn51sUE3CO"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"我们以前一节使用的 2022 年 9 月 22 日墨西哥 Mw 6.8 地震在 ANMO 台站的波形为例。","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"dqDXhUfrGP"}],"key":"vsE1Km19JC"}],"key":"QeofaQn42h"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from obspy import UTCDateTime\nfrom obspy.clients.fdsn import Client\nimport matplotlib.pyplot as plt\n\nclient = Client(\"IRIS\") \n\n# 下载 2022 年墨西哥 Mw 6.8 级地震在 ANMO 台站的波形数据(选择 400–700 s 时间窗)\norigin_time = UTCDateTime(\"2022-09-22T06:18:00\")\nstarttime = origin_time + 400\nendtime = origin_time + 700\nst = client.get_waveforms(\n    network=\"IU\",\n    station=\"ANMO\", \n    location=\"00\", \n    channel=\"BHZ\",\n    starttime=starttime, \n    endtime=endtime,\n)\nst.plot();","key":"IYoOTmL9hA"},{"type":"outputs","id":"RVREGq6Co9omF_jFXsJ2i","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/seismo-learn/lib/python3.14/site-packages/obspy/clients/fdsn/client.py:257: ObsPyDeprecationWarning: IRIS is now EarthScope, please consider changing the FDSN client short URL to 'EARTHSCOPE'.\n  warnings.warn(msg, ObsPyDeprecationWarning)\n"},"key":"YrDvF1N9KP"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x250 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f982d8024d27d95aeee73738db2eabf8","path":"/seismology101/_public/f982d8024d27d95aeee73738db2eabf8.png"}}},"key":"ZIAur4XTcM"}],"key":"QdiPdEW4wf"}],"key":"iz8gljsbD1"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"进行尖灭处理之前，通常先进行去均值、去线性趋势。","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"aSeS79qLoR"}],"key":"PndQ6gFNrR"}],"key":"T2oKoJibHX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tr = st[0]\n\n# 去均值 + 去趋势\ntr.detrend(\"demean\")\ntr.detrend(\"linear\")\n\ntr_origin = tr.copy()   # 备份原始波形","key":"BCwbQRzoB3"},{"type":"outputs","id":"F5RJzngifgLs20GjNLkrN","children":[],"key":"PRoxbYiTPe"}],"key":"xO8t9vUXOM"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":101,"column":