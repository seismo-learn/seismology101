n class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">∗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">x</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.05724em;\">j</span><span class=\"mclose\">)</span><span class=\"mpunct\">,</span></span></span></span></span>","enumerator":"1","key":"KFG9RvSTuV"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"其中 ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"mXgGA2DDO5"},{"type":"inlineMath","value":"w(j)","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>w</mi><mo stretchy=\"false\">(</mo><mi>j</mi><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">w(j)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.02691em;\">w</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.05724em;\">j</span><span class=\"mclose\">)</span></span></span></span>","key":"MDat9PFlp2"},{"type":"text","value":" 在信号首尾逐渐从 0 过渡到 1，并在中间区域保持为 1，实现波形的尖灭。","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"enixLSRg5p"}],"key":"xt27LsdshY"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"下图比较了两种常用的尖灭窗：余弦窗 (cosine) 与 Hanning 窗 (hann)。本示例中，两端各 5% 长度用于平滑渐入/渐出，中间部分保持幅度 1。","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"TeAegaRgGv"}],"key":"KSXtNAHP8n"}],"key":"EsEN7L0Gjf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom obspy.signal.invsim import cosine_taper  # ObsPy 余弦尖灭\n\n# 参数设置\nnpts = 1000\np = 0.05  # 两端 5%\n\n# 余弦尖灭窗\nwin_cos = cosine_taper(npts, p=p)\n\n# Hanning 窗（构造两端平滑、中间平坦）\nwin_han = np.ones(npts)\nedge = int(p * npts)\nhan_full = np.hanning(2 * edge)\nwin_han[:edge] = han_full[:edge]\nwin_han[-edge:] = han_full[-edge:]\n\nx = np.linspace(0, 1, npts)\nplt.figure(figsize=(9, 4))\nplt.plot(x, win_cos, 'r-', lw=2, label=f'Cosine (p={p})')\nplt.plot(x, win_han, 'b--', lw=2, label=f'Hanning (p={p})')\nplt.xlabel('Normalized Time')\nplt.ylabel('Amplitude')\nplt.title('Cosine vs Hanning Taper Windows')\nplt.legend()\nplt.show()","visibility":"hide","key":"QN4uFzU3aL"},{"type":"outputs","id":"6srNtFb5sTPaDsJtWrQOF","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 900x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"21d8fdaba4b19f7a8b1e4d62c1135885","path":"/seismology101/build/21d8fdaba4b19f7a8b1e4d62c1135885.png"}}},"key":"uHvWkzgLYI"}],"visibility":"show","key":"GOcAGqNJyQ"}],"data":{"tags":[]},"visibility":"show","key":"g6Ejz7dxjD"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"我们以前一节使用的 2022 年 9 月 22 日墨西哥 Mw 6.8 地震在 ANMO 台站的波形为例。","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"YszBxHNJch"}],"key":"g7CpRIia4X"}],"key":"AJWhT5V6hV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from obspy import UTCDateTime\nfrom obspy.clients.fdsn import Client\nimport matplotlib.pyplot as plt\n\nclien