":"uDysTsLNNY"}],"key":"vv0pMCnhW4"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"首先，需要把地震目录准备好。这里我们选择下载 2000–2010 年间震级大于 4.8 级，\n震源深度大于 50 km 的地震。这一地震目录中共计约 7000 个地震：","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"n97sRH9cC8"}],"key":"DkeqlanERg"}],"key":"hPRUtsZTrw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from obspy.clients.fdsn import Client\n\nclient = Client(\"USGS\")\ncat = client.get_events(\n    starttime=\"2000-01-01\",\n    endtime=\"2010-01-01\",\n    minmagnitude=4.8,\n    mindepth=50,\n)\nprint(cat)","key":"heGYkJbiJb"},{"type":"outputs","id":"SAZdFtkFa-gCdkeXCTqC-","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"6982 Event(s) in Catalog:\n2009-12-31T17:42:15.960000Z | -19.747, -177.753 | 5.4  mwc | manual\n2009-12-31T09:06:01.250000Z |  -7.499, +127.930 | 5.1  mb | manual\n...\n2000-01-02T12:14:39.090000Z | -17.943, -178.476 | 5.5  mwc | manual\n2000-01-01T05:24:35.290000Z | +36.874,  +69.947 | 5.1  mwc | manual\nTo see all events call 'print(CatalogObject.__str__(print_all=True))'\n"},"key":"mag8fiYDEy"}],"key":"Fv4kIqJNkw"}],"key":"SCH5Ck5bvc"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"为了进一步对数据做处理以及绘图，我们还需要导入 ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"yHPTTXfvfa"},{"type":"link","url":"https://numpy.org/","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"NumPy","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"LPH8LKX2T8"}],"urlSource":"https://numpy.org/","key":"LWsbhoxuBm"},{"type":"text","value":"\n和 ","position":{"start":{"line":41,"column":1},"end":{"line":41,"colum