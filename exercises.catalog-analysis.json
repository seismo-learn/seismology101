ode","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots()\nax.semilogy(mw, counts, \"o\")\nax.set_xlabel(\"Magnitude\")\nax.set_ylabel(\"Cumulative Number of earthquakes\")\nplt.show()","key":"nM2ejA9icE"},{"type":"outputs","id":"2PrQfwUItQTAcgsOCCIaG","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"c9123fd2760d6d8568bbb4e95399aac0","path":"/seismology101/build/c9123fd2760d6d8568bbb4e95399aac0.png"}}},"key":"CHGgOB5Gog"}],"key":"XGU5lI67mE"}],"key":"bGtDbZdVcE"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":105,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"更进一步，我们可以对 4.8-7.6 级之间的数据进行线性拟合，得到 GR 定律中的系数 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"lkiFI8TBBy"},{"type":"inlineMath","value":"a","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>a</mi></mrow><annotation encoding=\"application/x-tex\">a</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">a</span></span></span></span>","key":"rUicq0hHpm"},{"type":"text","value":" 和 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"PqWoYKON6w"},{"type":"inlineMath","value":"b","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>b</mi></mrow><annotation encoding=\"application/x-tex\">b</annotation></semantics></m