ode","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots()\nax.semilogy(mw, counts, \"o\")\nax.set_xlabel(\"Magnitude\")\nax.set_ylabel(\"Cumulative Number of earthquakes\")\nplt.show()","key":"nd6rKgVpJP"},{"type":"outputs","id":"FM7zAd_-uMXo8iJq6kOi0","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"a741b9fc7623c211730a42072edbb369","path":"/seismology101/build/a741b9fc7623c211730a42072edbb369.png"}}},"key":"bbYb96seN1"}],"key":"ALhnnqW1su"}],"key":"lNlf8gt72T"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":105,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"更进一步，我们可以对 4.8-7.6 级之间的数据进行线性拟合，得到 GR 定律中的系数 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"Jp91zgxmjA"},{"type":"inlineMath","value":"a","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>a</mi></mrow><annotation encoding=\"application/x-tex\">a</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">a</span></span></span></span>","key":"dBw7yxig94"},{"type":"text","value":" 和 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"G4p5MJp0aU"},{"type":"inlineMath","value":"b","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>b</mi></mrow><annotation encoding=\"application/x-tex\">b</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\">b</span></span></span></span>","key":"fbfmqIGM8M"},{"type":"text","value":"。\n这里我们采用 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"Xc8GzXELF8"},{"type":"inlineCode","value":"numpy.logical_and","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"o31GdVRsf3"},{"type":"text","value":" 函数找到数组 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"gYAqUa99Re"},{"type":"inlineCode","value":"mw","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"mMWNvPz9M4"},{"type":"text","value":" 中所有满足条件的元素的索引，\n并使用 NumPy 的布尔索引功能筛选出满足条件的震级 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"Xyl9XqNEVp"},{"type":"inlineCode","value":"mw[idx]","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"gePBmH8A9A"},{"type":"text","value":" 和对应的 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"muxGMVWy0l"},{"type":"inlineCode","value":"counts[idx]","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"UYlvQGTeWC"},{"type":"text","value":"，再\n使用 ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"MxUL2eLYuS"},{"type":"inlineCode","value":"numpy.polyfit","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"VyAT29wXD7"},{"type":"text","value":" 函数拟合一元一次多项式，最后绘图：","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"KZCmnabpyn"}],"key":"XqV4WHNgo1"}],"key":"NWcDwx0pys"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"idx = np.logical_and(mw >= 4.8, mw <= 7.5)\n# fitting y = p[0] * x + p[1]\np = np.polyfit(mw[idx], np.log10(counts[idx]), 1)\nN_pred = 10 ** (mw * p[0] + p[1])\n\nfig, ax = plt.subplots()\nax.semilogy(mw, counts, \"o\")\nax.semilogy(mw, N_pred, color=\"red\", label=rf\"$\\log_{{10}} N={p[1]:.2f}{p[0]:.2f}M$\")\nax.legend()\nax.set_xlabel(\"Magnitude\")\nax.set_ylabel(\"Cumulative Number of earthquakes\")\nplt.show()","key":"rdplMlEmYc"},{"type":"outputs","id":"32uWQOMAV-gk-rf2xj4Gd","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"8d29f58d19f9c689250e71e3a7abf968","path":"/seismology101/build/8d29f58d19f9c689250e71e3a7abf968.png"}}},"key":"jpnPtPbuGR"}],"key":"wS9JtAIoZq"}],"key":"eA6r1ymNHG"}],"key":"sFsr6sUGcz"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"数据分析","url":"/exercises/analysis","group":"地震学实践"},"next":{"title":"质点运动轨迹","url":"/exercises/particle-motion","group":"地震学实践"}}},"domain":"http://localhost:3000"}