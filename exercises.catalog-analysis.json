nN_pred = 10 ** (mw * p[0] + p[1])\n\nfig, ax = plt.subplots()\nax.semilogy(mw, counts, \"o\")\nax.semilogy(mw, N_pred, color=\"red\", label=rf\"$\\log_{{10}} N={p[1]:.2f}{p[0]:.2f}M$\")\nax.legend()\nax.set_xlabel(\"Magnitude\")\nax.set_ylabel(\"Cumulative Number of earthquakes\")\nplt.show()","key":"CcbfAJe1Zb"},{"type":"outputs","id":"Mv4Z7_As2_JJS8qKBOCP8","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"d3d1020845d3a7d91039af30e99cbbdf","path":"/seismology101/build/d3d1020845d3a7d91039af30e99cbbdf.png"}}},"key":"Wl4hFzH6wt"}],"key":"G74FVTrW4H"}],"key":"StwtMhFQT9"}],"key":"Cg3Lf1KkNh"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"数据分析","url":"/exercises/analysis","group":"地震学实践"},"next":{"title":"质点运动轨迹","url":"/exercises/particle-motion","group":"地震学实践"}}},"domain":"http://localhost:3000"}