e":"最流行","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"YhaED29JIE"}],"key":"UvuVj0U9VQ"},{"type":"text","value":"的波形数据格式。","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"fW5dNCF6FY"}],"key":"Ktvdq881CT"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"SAC","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"OL13ulbr2n"}],"identifier":"sac","label":"SAC","html_id":"sac","implicit":true,"key":"CUD2nKLjOI"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"SAC 格式由 ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"z6pfmIGfuv"},{"type":"link","url":"https://ds.iris.edu/ds/nodes/dmc/software/downloads/SAC/","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"SAC","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"VpljNzHfUX"}],"urlSource":"https://ds.iris.edu/ds/nodes/dmc/software/downloads/SAC/","key":"G24FqTUxy2"},{"type":"text","value":"\n（Seismic Analysis Codes）软件定义，但许多其他软件也支持该格式。每个 SAC 文件包含头段区\n和时间序列数据区，其中头段区定义了与台站、事件、走时以及用户自定义信息等相关的变量。","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"jY0otaJmxW"}],"key":"uJ9giW3Gaj"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"SAC 是一款常用的地震学波形处理和分析软件，同时，SAC 格式的数据中可以保存一些元数据和事件信息，\n使得 SAC 格式是日常科研中的常用数据格式。但若选择该格式来存储数据，则需要很大的硬盘空间。","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"gizrzoMe5c"}],"key":"wjYbqdgM3V"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"miniSEED","position":{"start":{"line":24,"column":1},"end":{"line":24,"c